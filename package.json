{
  "name": "@hklmtt/falinks",
  "version": "0.14.0",
  "description": "把多个终端 AI CLI（Claude Code、Codex…）编排成一间办公室：分屏真实窗口里的员工，通过 MCP 总线互相对话协作，外加一个控制台。",
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "claude-code",
    "codex",
    "mcp",
    "iterm2",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HKLMTT/falinks.git"
  },
  "homepage": "https://github.com/HKLMTT/falinks#readme",
  "bugs": {
    "url": "https://github.com/HKLMTT/falinks/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "falinks": "dist/cli.js"
  },
  "files": [
    "dist",
    "falinks.config.example.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-office-web.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.30",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.5",
    "react": "^18.3.1",
    "zod": "^4.4.3"
  }
}
